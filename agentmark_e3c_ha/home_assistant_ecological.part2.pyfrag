        "task_id": task_id,
        "mode": mode,
        "feedback_at_deadline": feedback,
        "supported_next_operation": supported_next,
        "observed_decision_operation": observed_decision_op,
        "support_violation": support_violation,
        "verify_called": verify_called,
        "act1_issue_ms": 0.0,
        "act1_complete_ms": ns_to_ms(act1_complete_ns - t0),
        "act2_issue_ms": ns_to_ms(act2_issue_ns - t0),
        "final_ms": ns_to_ms(final_ns - t0),
        "source_act2_issue_ms": trace.act2_issue_ms,
        "act2_issue_shift_vs_source_ms": ns_to_ms(act2_issue_ns - t0) - trace.act2_issue_ms,
        "visible_event_ms": None if visible_ns is None else ns_to_ms(visible_ns - t0),
    }


async def run_mode(
    hass: HomeAssistant,
    mode: str,
    run_id: str,
    source: list[SourceTaskTrace],
    *,
    target_delay_ms: float,
    verify_ms: float,
    wave_size: int,
    wave_period_ms: float,
    policy_sensitive: bool,
) -> list[dict[str, Any]]:
    by_index = {t.task_index: t for t in source}
    rows = await launch_waves(
        lambda i: replay_task(
            hass,
            mode,
            run_id,
            by_index[i],
            target_delay_ms=target_delay_ms,
            verify_ms=verify_ms,
            policy_sensitive=policy_sensitive,
        ),
        len(source),
        wave_size,
        wave_period_ms,
    )
    # Home Assistant dispatches event callbacks as tracked jobs. A single
    # asyncio loop turn is not a completeness barrier; use HA's own drain.
    await hass.async_block_till_done()
    return sorted(rows, key=lambda r: r["task_index"])


def summarize_rows(rows: list[dict[str, Any]]) -> dict[str, Any]:
    n = len(rows)
    return {
        "n": n,
        "feedback_miss_rate": sum(r["feedback_at_deadline"] == "MISS" for r in rows) / n,
        "support_violation_rate": sum(bool(r["support_violation"]) for r in rows) / n,
        "verify_fraction": sum(bool(r["verify_called"]) for r in rows) / n,
        "act2_issue_shift_vs_source_mean_ms": statistics.fmean(r["act2_issue_shift_vs_source_ms"] for r in rows),
        "act2_issue_shift_vs_source_p50_ms": percentile([r["act2_issue_shift_vs_source_ms"] for r in rows], 0.50),
        "act2_issue_shift_vs_source_p99_ms": percentile([r["act2_issue_shift_vs_source_ms"] for r in rows], 0.99),
        "final_p50_ms": percentile([r["final_ms"] for r in rows], 0.50),
        "final_p99_ms": percentile([r["final_ms"] for r in rows], 0.99),
    }


def event_slice(lab: HALab, run_id: str) -> dict[str, Any]:
    calls = [e for e in lab.call_events if str(e["service_data"].get("run_id")) == run_id]
    states = [e for e in lab.state_events if str(e["attributes"].get("agentmark_run")) == run_id]
    call_counts = Counter(e["service"] for e in calls)

    # HA-native Context lineage: service call event and service-induced state
    # change must carry the same context id for ACT1/ACT2.
    by_key: dict[tuple[str, str], list[str]] = defaultdict(list)
    for e in calls:
        task_id = str(e["service_data"].get("task_id"))
        by_key[(task_id, str(e["service"]))].append(str(e["context_id"]))
    matches = 0
    eligible = 0
    state_details = []
    for e in states:
        cause = e["attributes"].get("cause")
        service = ACT1 if cause == "act1_visible" else ACT2 if cause == "act2_commit" else None
        if service is None:
            continue
        task_id = str(e["attributes"].get("agentmark_task"))
        expected = by_key.get((task_id, service), [])
        eligible += 1
        ok = str(e["context_id"]) in expected
        matches += int(ok)
        state_details.append({
            "task_id": task_id,
            "cause": cause,
            "context_id": str(e["context_id"]),
            "matching_call_context": ok,
        })
    return {
        "call_service_count": len(calls),
        "call_service_by_operation": dict(sorted(call_counts.items())),
        "state_changed_count": len(states),
        "context_lineage_eligible": eligible,
        "context_lineage_matches": matches,
        "context_lineage_fraction": 1.0 if eligible == 0 else matches / eligible,
        "context_lineage_all_match": matches == eligible,
        "state_context_details": state_details,
    }


def sensitive_kernel() -> ReactiveKernel:
    return ReactiveKernel(
        {
            "initial_state": "decision",
            "feedback_alphabet": ["VISIBLE", "MISS"],
            "states": {
                "decision": {
                    "VISIBLE": [{"p": 1, "operation": "ACT2", "next_state": "done"}],
                    "MISS": [{"p": 1, "operation": "VERIFY", "next_state": "verified"}],
                },
                "verified": {
                    "VISIBLE": [{"p": 1, "operation": "ACT2", "next_state": "done"}],
                    "MISS": [{"p": 1, "operation": "ACT2", "next_state": "done"}],
                },
                "done": {
                    "VISIBLE": [{"p": 1, "operation": "STOP", "next_state": "done"}],
                    "MISS": [{"p": 1, "operation": "STOP", "next_state": "done"}],
                },
            },
        }
    )


def insensitive_kernel() -> ReactiveKernel:
    return ReactiveKernel(
        {
            "initial_state": "decision",
            "feedback_alphabet": ["VISIBLE", "MISS"],
            "states": {
                "decision": {
                    "VISIBLE": [{"p": 1, "operation": "ACT2", "next_state": "done"}],
                    "MISS": [{"p": 1, "operation": "ACT2", "next_state": "done"}],
                },
                "done": {
                    "VISIBLE": [{"p": 1, "operation": "STOP", "next_state": "done"}],
                    "MISS": [{"p": 1, "operation": "STOP", "next_state": "done"}],
                },
            },
        }
    )


def certificate_for(kernel: ReactiveKernel, source_rows: list[SourceTaskTrace], target_rows: list[dict[str, Any]]) -> dict[str, Any]:
    source_counts = {"VISIBLE": len(source_rows), "MISS": 0}
    target_counts = Counter(r["feedback_at_deadline"] for r in target_rows)
    return high_confidence_replay_certificate(
        kernel,
        "decision",
        source_counts,
        target_counts,
        delta=0.05,
        epsilon=0.05,
        projection="operation",
    )


def trace_support(kernel: ReactiveKernel, rows: list[dict[str, Any]], operation: str) -> dict[str, Any]:
    compat_rows = [
        {
            "state": "decision",
            "source_feedback": "VISIBLE",
            "target_feedback": r["feedback_at_deadline"],
            "operation": operation,
        }
        for r in rows
    ]
    return trace_compatibility(kernel, compat_rows)


async def experiment(args: argparse.Namespace) -> dict[str, Any]:
    with tempfile.TemporaryDirectory(prefix="agentmark-ha-") as config_dir:
        hass = HomeAssistant(config_dir)
        hass.set_state(CoreState.running)
        lab = HALab(hass)
        lab.install()
        try:
            source = await record_source(
                hass,
                n_tasks=args.tasks,
                wave_size=args.wave_size,
                wave_period_ms=args.wave_period_ms,
                source_delay_ms=args.source_delay_ms,
                verify_ms=args.verify_ms,
            )
            source_summary = {
                "tasks": len(source),
                "act1_complete_p50_ms": percentile([t.act1_complete_ms for t in source], 0.50),
                "act1_complete_p99_ms": percentile([t.act1_complete_ms for t in source], 0.99),
                "act1_complete_max_ms": max(t.act1_complete_ms for t in source),
                "act2_issue_p50_ms": percentile([t.act2_issue_ms for t in source], 0.50),
                "act2_issue_p99_ms": percentile([t.act2_issue_ms for t in source], 0.99),
                "all_visible_by_deadline": max(t.act1_complete_ms for t in source) < args.verify_ms,
            }
            if not source_summary["all_visible_by_deadline"]:
                raise AssertionError("source trace invalid under frozen controller deadline")

            sensitive = sensitive_kernel()
            decisive_trials = []
            for trial in range(args.trials):
                modes = {}
                for mode in ("R0", "R1", "R2"):
                    run_id = f"decisive_t{trial}_{mode.lower()}"
                    rows = await run_mode(
                        hass,
                        mode,
                        run_id,
                        source,
                        target_delay_ms=args.target_delay_ms,
                        verify_ms=args.verify_ms,
                        wave_size=args.wave_size,
                        wave_period_ms=args.wave_period_ms,
                        policy_sensitive=True,
                    )
