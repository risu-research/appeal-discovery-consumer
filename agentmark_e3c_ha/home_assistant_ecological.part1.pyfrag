# Reuse the already-promoted AgentMark kernel/certificate implementation rather
# than copying certificate math into E3c. The workflow mounts the repository at
# /repo and sets PYTHONPATH accordingly.
from agentmark.certificate import high_confidence_replay_certificate, trace_compatibility
from agentmark.kernel import ReactiveKernel

DOMAIN = "agentmark_lab"
ACT1 = "act1"
VERIFY = "verify"
ACT2 = "act2"


def now_ns() -> int:
    return time.perf_counter_ns()


def ns_to_ms(ns: int) -> float:
    return ns / 1_000_000.0


def percentile(values: list[float], q: float) -> float:
    if not values:
        return math.nan
    xs = sorted(values)
    if len(xs) == 1:
        return xs[0]
    pos = (len(xs) - 1) * q
    lo, hi = math.floor(pos), math.ceil(pos)
    if lo == hi:
        return xs[lo]
    w = pos - lo
    return xs[lo] * (1 - w) + xs[hi] * w


@dataclass(frozen=True)
class SourceTaskTrace:
    task_index: int
    act1_issue_ms: float
    act1_complete_ms: float
    act2_issue_ms: float
    act2_complete_ms: float

    @property
    def think_after_act1_ms(self) -> float:
        return max(0.0, self.act2_issue_ms - self.act1_complete_ms)


class HALab:
    """Actual Home Assistant Core ServiceRegistry/EventBus/StateMachine substrate."""

    def __init__(self, hass: HomeAssistant):
        self.hass = hass
        self.call_events: list[dict[str, Any]] = []
        self.state_events: list[dict[str, Any]] = []
        self.service_completions: list[dict[str, Any]] = []
        self._unsubs: list[Callable[[], None]] = []

    def install(self) -> None:
        @callback
        def on_call(event: Event) -> None:
            data = event.data
            if data.get("domain") != DOMAIN:
                return
            service_data = dict(data.get("service_data") or {})
            self.call_events.append(
                {
                    "t_ns": now_ns(),
                    "service": data.get("service"),
                    "service_data": service_data,
                    "context_id": str(event.context.id),
                    "context_parent_id": None if event.context.parent_id is None else str(event.context.parent_id),
                }
            )

        @callback
        def on_state(event: Event) -> None:
            entity_id = event.data.get("entity_id")
            if not isinstance(entity_id, str) or not entity_id.startswith(("binary_sensor.agentmark_", "sensor.agentmark_")):
                return
            new_state = event.data.get("new_state")
            self.state_events.append(
                {
                    "t_ns": now_ns(),
                    "entity_id": entity_id,
                    "new_state": None if new_state is None else new_state.state,
                    "attributes": {} if new_state is None else dict(new_state.attributes),
                    "context_id": str(event.context.id),
                    "context_parent_id": None if event.context.parent_id is None else str(event.context.parent_id),
                }
            )

        self._unsubs.append(self.hass.bus.async_listen(EVENT_CALL_SERVICE, on_call))
        self._unsubs.append(self.hass.bus.async_listen(EVENT_STATE_CHANGED, on_state))

        async def act1(call) -> None:
            data = call.data
            delay_ms = float(data["delay_ms"])
            entity_id = str(data["entity_id"])
            await asyncio.sleep(delay_ms / 1000.0)
            self.hass.states.async_set(
                entity_id,
                "on",
                {
                    "agentmark_task": str(data["task_id"]),
                    "agentmark_run": str(data["run_id"]),
                    "cause": "act1_visible",
                    "command_delay_ms": delay_ms,
                },
                context=call.context,
            )
            self.service_completions.append(
                {
                    "t_ns": now_ns(),
                    "service": ACT1,
                    "task_id": str(data["task_id"]),
                    "run_id": str(data["run_id"]),
                    "context_id": str(call.context.id),
                }
            )

        async def verify(call) -> None:
            data = call.data
            entity_id = str(data["entity_id"])
            timeout_ms = float(data.get("timeout_ms", 1000.0))
            visible, visible_ns = await wait_for_on(self.hass, entity_id, timeout_ms)
            self.service_completions.append(
                {
                    "t_ns": now_ns(),
                    "service": VERIFY,
                    "task_id": str(data["task_id"]),
                    "run_id": str(data["run_id"]),
                    "context_id": str(call.context.id),
                    "visible": visible,
                    "visible_event_ns": visible_ns,
                }
            )

        async def act2(call) -> None:
            data = call.data
            entity_id = str(data["commit_entity_id"])
            self.hass.states.async_set(
                entity_id,
                "committed",
                {
                    "agentmark_task": str(data["task_id"]),
                    "agentmark_run": str(data["run_id"]),
                    "cause": "act2_commit",
                },
                context=call.context,
            )
            self.service_completions.append(
                {
                    "t_ns": now_ns(),
                    "service": ACT2,
                    "task_id": str(data["task_id"]),
                    "run_id": str(data["run_id"]),
                    "context_id": str(call.context.id),
                }
            )

        self.hass.services.async_register(DOMAIN, ACT1, act1)
        self.hass.services.async_register(DOMAIN, VERIFY, verify)
        self.hass.services.async_register(DOMAIN, ACT2, act2)

    def close(self) -> None:
        for unsub in self._unsubs:
            unsub()
        self._unsubs.clear()


async def wait_for_on_until(
    hass: HomeAssistant,
    entity_id: str,
    deadline_ns: int,
) -> tuple[bool, int | None]:
    """Observe one entity through HA's indexed callback path to an absolute deadline.

    The previous implementation registered one global EVENT_STATE_CHANGED listener
    per task. Because those plain ``def`` listeners were classified by Home
    Assistant as Executor jobs, a 32-task wave generated O(N^2) executor fanout
    and cross-thread ``asyncio.Future.set_result`` calls. This observer uses Home
    Assistant's entity-indexed helper and explicit Callback job type instead.

    A callback that executes after the absolute deadline is a MISS even if
    asyncio timeout scheduling happens to resume it before the timeout waiter.
    """
    now = now_ns()
    state = hass.states.get(entity_id)
    if state is not None and state.state == "on":
        return (now <= deadline_ns), (now if now <= deadline_ns else None)

    loop = asyncio.get_running_loop()
    fut: asyncio.Future[int] = loop.create_future()

    @callback
    def listener(event: Event) -> None:
        new_state = event.data.get("new_state")
        if new_state is not None and new_state.state == "on" and not fut.done():
            fut.set_result(now_ns())

    unsub = async_track_state_change_event(
        hass,
        entity_id,
        listener,
        job_type=HassJobType.Callback,
    )
    try:
        # Close the state-check / listener-registration race without leaving the
        # event loop or creating executor work.
        state = hass.states.get(entity_id)
        if state is not None and state.state == "on" and not fut.done():
            observed_ns = now_ns()
            if observed_ns <= deadline_ns:
                fut.set_result(observed_ns)
            else:
                return False, None

        remaining_s = max(0.0, (deadline_ns - now_ns()) / 1_000_000_000.0)
        if remaining_s <= 0.0:
            return False, None
        try:
            event_ns = await asyncio.wait_for(fut, timeout=remaining_s)
        except TimeoutError:
            return False, None

        # Strict absolute-deadline semantics. This guard matters if the event
        # loop resumes both a late callback and the timeout after a scheduler
        # stall; callback ordering must not turn a post-deadline event into a hit.
        if event_ns > deadline_ns:
            return False, None
        return True, event_ns
    finally:
        unsub()


async def wait_for_on(
    hass: HomeAssistant,
    entity_id: str,
    timeout_ms: float,
) -> tuple[bool, int | None]:
    return await wait_for_on_until(
        hass,
        entity_id,
        now_ns() + int(timeout_ms * 1_000_000.0),
    )


async def sleep_until_ns(deadline_ns: int) -> None:
    remaining_s = (deadline_ns - now_ns()) / 1_000_000_000.0
    if remaining_s > 0:
        await asyncio.sleep(remaining_s)


def ids(run_id: str, task_index: int) -> tuple[str, str, str]:
    safe = run_id.lower().replace("-", "_")
    task_id = f"{safe}_{task_index:04d}"
    return task_id, f"binary_sensor.agentmark_{task_id}", f"sensor.agentmark_commit_{task_id}"


async def call_service(
    hass: HomeAssistant,
    service: str,
    data: dict[str, Any],
    *,
    blocking: bool,
    context: Context | None = None,
    issued: asyncio.Future[int] | None = None,
) -> tuple[int, int]:
    # The scientific deadline is defined relative to operation issue, not to
    # coroutine creation.  Set the clock only once this coroutine is actually
    # scheduled and immediately before Home Assistant receives async_call().
    issue_ns = now_ns()
    if issued is not None and not issued.done():
        issued.set_result(issue_ns)
    await hass.services.async_call(
        DOMAIN,
        service,
        data,
        blocking=blocking,
        context=context,
    )
    complete_ns = now_ns()
    return issue_ns, complete_ns


async def source_task(
    hass: HomeAssistant,
    run_id: str,
    task_index: int,
    *,
    source_delay_ms: float,
    verify_ms: float,
) -> SourceTaskTrace:
    task_id, entity_id, commit_entity_id = ids(run_id, task_index)
    loop = asyncio.get_running_loop()
    act1_issued: asyncio.Future[int] = loop.create_future()
    act1_ctx = Context()
    act1_task = asyncio.create_task(
        call_service(
            hass,
            ACT1,
            {
                "run_id": run_id,
                "task_id": task_id,
                "entity_id": entity_id,
                "delay_ms": source_delay_ms,
            },
            blocking=True,
            context=act1_ctx,
            issued=act1_issued,
        )
    )
    act1_issue_ns = await act1_issued
    visible, visible_ns = await wait_for_on_until(
        hass,
        entity_id,
        act1_issue_ns + int(verify_ms * 1_000_000.0),
    )
    if not visible:
        await act1_task
        raise AssertionError(f"source task {task_id} missed frozen verify deadline")

    _, act1_complete_ns = await act1_task

    act2_issued: asyncio.Future[int] = loop.create_future()
    act2_task = asyncio.create_task(
        call_service(
            hass,
            ACT2,
            {
                "run_id": run_id,
                "task_id": task_id,
                "commit_entity_id": commit_entity_id,
            },
            blocking=True,
            context=Context(),
            issued=act2_issued,
        )
    )
    act2_issue_ns = await act2_issued
    _, act2_complete_ns = await act2_task

    return SourceTaskTrace(
        task_index=task_index,
        act1_issue_ms=0.0,
        act1_complete_ms=ns_to_ms(act1_complete_ns - act1_issue_ns),
        act2_issue_ms=ns_to_ms(act2_issue_ns - act1_issue_ns),
        act2_complete_ms=ns_to_ms(act2_complete_ns - act1_issue_ns),
    )


async def launch_waves(
    one: Callable[[int], Any],
    n_tasks: int,
    wave_size: int,
    wave_period_ms: float,
) -> list[Any]:
    pending: list[asyncio.Task] = []
    for start in range(0, n_tasks, wave_size):
        for i in range(start, min(n_tasks, start + wave_size)):
            pending.append(asyncio.create_task(one(i)))
        if start + wave_size < n_tasks:
            await asyncio.sleep(wave_period_ms / 1000.0)
    return await asyncio.gather(*pending)


async def record_source(
    hass: HomeAssistant,
    *,
    n_tasks: int,
    wave_size: int,
    wave_period_ms: float,
    source_delay_ms: float,
    verify_ms: float,
) -> list[SourceTaskTrace]:
    run_id = "source"
    traces = await launch_waves(
        lambda i: source_task(
            hass,
            run_id,
            i,
            source_delay_ms=source_delay_ms,
            verify_ms=verify_ms,
        ),
        n_tasks,
        wave_size,
        wave_period_ms,
    )
    await hass.async_block_till_done()
    return sorted(traces, key=lambda x: x.task_index)


async def replay_task(
    hass: HomeAssistant,
    mode: str,
    run_id: str,
    trace: SourceTaskTrace,
    *,
    target_delay_ms: float,
    verify_ms: float,
    policy_sensitive: bool,
) -> dict[str, Any]:
    task_index = trace.task_index
    task_id, entity_id, commit_entity_id = ids(run_id, task_index)
    loop = asyncio.get_running_loop()

    act1_issued: asyncio.Future[int] = loop.create_future()
    act1_ctx = Context()
    act1_task = asyncio.create_task(
        call_service(
            hass,
            ACT1,
            {
                "run_id": run_id,
                "task_id": task_id,
                "entity_id": entity_id,
                "delay_ms": target_delay_ms,
            },
            blocking=True,
            context=act1_ctx,
            issued=act1_issued,
        )
    )
    act1_issue_ns = await act1_issued
    t0 = act1_issue_ns
    monitor = asyncio.create_task(
        wait_for_on_until(
            hass,
            entity_id,
            t0 + int(verify_ms * 1_000_000.0),
        )
    )

    verify_called = False
    if mode == "R0":
        # Preserve the recorded source issue schedule against the actual target
        # ACT1 issue clock, not against coroutine creation/scheduler queue time.
        await sleep_until_ns(t0 + int(trace.act2_issue_ms * 1_000_000.0))
        act2_issued: asyncio.Future[int] = loop.create_future()
        act2_task = asyncio.create_task(
            call_service(
                hass,
                ACT2,
                {"run_id": run_id, "task_id": task_id, "commit_entity_id": commit_entity_id},
                blocking=True,
                context=Context(),
                issued=act2_issued,
            )
        )
        act2_issue_ns = await act2_issued
        await act2_task
        visible_by_deadline, visible_ns = await monitor
        _, act1_complete_ns = await act1_task
    elif mode == "R1":
        _, act1_complete_ns = await act1_task
        await asyncio.sleep(trace.think_after_act1_ms / 1000.0)
        act2_issued = loop.create_future()
        act2_task = asyncio.create_task(
            call_service(
                hass,
                ACT2,
                {"run_id": run_id, "task_id": task_id, "commit_entity_id": commit_entity_id},
                blocking=True,
                context=Context(),
                issued=act2_issued,
            )
        )
        act2_issue_ns = await act2_issued
        await act2_task
        visible_by_deadline, visible_ns = await monitor
    elif mode == "R2":
        visible_by_deadline, visible_ns = await monitor
        if policy_sensitive and not visible_by_deadline:
            verify_called = True
            await call_service(
                hass,
                VERIFY,
                {
                    "run_id": run_id,
                    "task_id": task_id,
                    "entity_id": entity_id,
                    "timeout_ms": max(1000.0, target_delay_ms * 4.0),
                },
                blocking=True,
                context=Context(),
            )
        _, act1_complete_ns = await act1_task
        act2_issued = loop.create_future()
        act2_task = asyncio.create_task(
            call_service(
                hass,
                ACT2,
                {"run_id": run_id, "task_id": task_id, "commit_entity_id": commit_entity_id},
                blocking=True,
                context=Context(),
                issued=act2_issued,
            )
        )
        act2_issue_ns = await act2_issued
        await act2_task
    else:
        raise ValueError(mode)

    final_ns = now_ns()
    feedback = "VISIBLE" if visible_by_deadline else "MISS"
    supported_next = "ACT2" if (not policy_sensitive or visible_by_deadline) else "VERIFY"
    observed_decision_op = "VERIFY" if verify_called else "ACT2"
    support_violation = observed_decision_op != supported_next

    return {
        "task_index": task_index,
